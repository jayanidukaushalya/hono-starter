{
  "name": "hono-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "Jayanidu Hettiarachchi",
    "email": "jayanidukaushalya@gmail.com",
    "url": "https://github.com/jayanidukaushalya/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jayanidukaushalya/hono-starter"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "NODE_ENV=production bun run dist/index.js",
    "test": "bun test",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.13.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.1.10"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
