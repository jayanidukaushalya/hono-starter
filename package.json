{
  "name": "hono-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "Jayanidu Hettiarachchi",
    "email": "jayanidukaushalya@gmail.com",
    "url": "https://github.com/jayanidukaushalya/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jayanidukaushalya/hono-starter"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "NODE_ENV=production bun run dist/index.js",
    "test": "bun test",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
