# Port the server listens on
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_starter

# Whether to require SSL for the database connection (true | false)
DATABASE_SSL=false

# Secret used to sign sessions/cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of this API (used for cookie domain, callback URLs, etc.)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (leave empty to allow none)
CORS_ORIGINS=http://localhost:3000
